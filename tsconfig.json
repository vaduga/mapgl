{
  "extends": "./.config/tsconfig.json",
  "compilerOptions": {
    "customConditions": ["development"],
    "rootDir": ".",
    "ignoreDeprecations": "6.0",
    "removeComments": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "paths": {
      "*": ["./src/*"]
    }
  },
  "include": ["src", "panel-core/src", "panel-core/examples", "grafana-adapter/src", ".config/types"]
}
