{
  "name": "vaduga-mapgl-panel",
  "version": "2.10.7",
  "description": "Mapgl panel",
  "scripts": {
    "build": "rspack -c ./rspack.config.ts --env production",
    "dev": "rspack -w -c ./rspack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "node scripts/check-core-isolation.mjs --test-boundary && jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "sign": "sign-plugin",
    "core:pack": "node scripts/package-core.mjs",
    "core:check-isolation": "node scripts/check-core-isolation.mjs",
    "core:check-consumer": "node scripts/check-neutral-consumer.mjs"
  },
  "author": "Vadim Pyatakov",
  "license": "GPL-3.0",
  "devDependencies": {
    "braces": "file:patches/braces",
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^3.15.0",
    "@grafana/plugin-meta-extractor": "^0.13.0",
    "@grafana/sign-plugin": "^3.3.3",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.64.0",
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.13",
    "@swc/helpers": "^0.5.23",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "ajv": "^8.20.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.2.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "glob": "^13.0.6",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.9",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "rspack-plugin-virtual-module": "^1.0.1",
    "sass": "1.105.1",
    "sass-loader": "17.0.1",
    "style-loader": "4.0.0",
    "systemjs": "^6.15.1",
    "terser-webpack-plugin": "^5.6.1",
    "ts-checker-rspack-plugin": "^1.7.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "webpack-merge": "^6.0.1",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": "12.2.0"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/react": "9.4.0",
    "@emotion/css": "11.13.5",
    "@grafana/runtime": "13.2.3",
    "@grafana/ui": "13.2.3",
    "@vaduga/mapgl-grafana-adapter": "*",
    "@vaduga/mapgl-core": "*",
    "maplibre-gl": "^6.13.0",
    "mobx-react-lite": "^5.1.0",
    "process": "^0.11.10",
    "react": "^19.3.0"
  },
  "overrides": {
    "basic-ftp": "6.2.1",
    "fast-uri": "4.1.4",
    "fast-xml-builder": "1.1.7",
    "fast-xml-parser": "5.5.6",
    "flatted": "3.4.2",
    "js-cookie": "3.0.7",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
