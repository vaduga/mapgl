{
  "extends": "@grafana/tsconfig",
  "compilerOptions": {
    "alwaysStrict": true,
    "declaration": false,
    "rootDir": ".",
    "ignoreDeprecations": "6.0",
    "removeComments": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "resolveJsonModule": true,
    "paths": {
      "*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    ".config/types"
  ]
}
