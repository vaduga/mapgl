{
  "extends": "@grafana/tsconfig",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": false,
    "emitDeclarationOnly": false,
    "jsx": "react",
    "target": "ES2022",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "removeComments": false,
    "resolveJsonModule": true,
    "paths": {
      "@mapgl/panel-core": ["./src/index.ts"],
      "@mapgl/panel-core/featureContracts": ["./src/extension-points/featureContracts.ts"],
      "@mapgl/panel-core/graph": ["./src/graph/main.ts"],
      "@mapgl/panel-core/graph/packed-relations": ["./src/graph/frame/packedRelationReaders.ts"],
      "@mapgl/panel-core/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.*", "src/**/*.spec.*", "src/**/__tests__/**"]
}
